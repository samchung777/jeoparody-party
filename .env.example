# Local development credentials. Copy this file to .env (git-ignored) and fill in your own values.
# Read by Docker Compose (MySQL container) and by the app and tests (spring.config.import in application.yml).
# Write values without quotes.

# MySQL root password for the docker-compose database (tests log in as root to create jeopardy_test).
MYSQL_ROOT_PASSWORD=

# The app's own database user (created by docker compose on the first start).
DB_USER=jeopardy
DB_PASSWORD=

# Integration tests: usually root and the root password above.
TEST_DB_USER=root
TEST_DB_PASSWORD=
